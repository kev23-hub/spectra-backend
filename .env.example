# ---------------------------------------------------------------------------
# Variables d'environnement du backend Spectra.
# A recopier dans Render > votre service > Environment.
# ---------------------------------------------------------------------------

PORT=3000

# Base de donnees PostgreSQL. Render > New > Postgres, puis copiez ici la
# "Internal Database URL". OBLIGATOIRE : le serveur refuse de demarrer sans.
DATABASE_URL=

# Secret de signature des sessions. Une longue chaine aleatoire, par exemple :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-moi-en-une-longue-chaine-aleatoire

# Secret SEPARE pour les liens "gerer mon abonnement" envoyes par e-mail.
# Sans lui, changer JWT_SECRET casse d'un coup tous les liens de resiliation
# deja envoyes aux clients. Optionnel mais fortement recommande.
MANAGE_TOKEN_SECRET=

# APP_URL  = le SITE (Vercel)  : sert a construire les liens vers app.html,
#            index.html, et les pages de retour de paiement.
# API_URL  = le SERVEUR (Render) : sert aux liens /billing/manage et
#            /auth/reset envoyes par e-mail.
# Les deux etaient confondus : le lien de resiliation tombait en 404.
APP_URL=https://spectreautisme2026.vercel.app
API_URL=https://spectra-backend-1gob.onrender.com

# Origines autorisees a appeler l'API depuis un navigateur, separees par des
# virgules. Mettez ici vos domaines reels, y compris ceux de preview.
# (spectreautisme2026.vercel.app et spectra-nouveau.vercel.app sont toujours
# autorises par le code, meme s'ils manquent ici.)
ALLOWED_ORIGINS=https://spectreautisme2026.vercel.app,https://spectra-nouveau.vercel.app

# Nombre maximum de comptes rattaches a UN abonnement, le payeur inclus.
INVITE_MAX_ACCOUNTS=4

# --- Notifications push (Web Push) ------------------------------------------
# Generez une paire de cles avec : npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:contact@votre-domaine.example
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Paiements Stripe -------------------------------------------------------
# STRIPE_SECRET_KEY : cle secrete (sk_test_... puis sk_live_...) -- NE JAMAIS
#   la partager, la commiter dans Git, ou la coller dans une conversation.
# STRIPE_DEFAULT_PRICE_ID : identifiant du prix cree dans Stripe > Produits.
# STRIPE_WEBHOOK_SECRET : signature du webhook (whsec_...), donnee par Stripe
#   a la creation de l'endpoint https://VOTRE-API/billing/webhook
STRIPE_SECRET_KEY=
STRIPE_DEFAULT_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- Achats integres Amazon (application Fire) ------------------------------
# Dans l'application Amazon, l'abonnement se vend UNIQUEMENT par l'achat integre
# d'Amazon (regle de l'Appstore). Le serveur verifie chaque achat aupres d'Amazon.
# AMAZON_RVS_SECRET : cle partagee, a copier depuis
#   https://developer.amazon.com/sdk/shared-key.html
#   NE JAMAIS la coller dans une conversation, ni dans Git.
# AMAZON_RVS_MODE : laissez VIDE (= production). Mettez "auto" uniquement pendant
#   vos essais avec l'outil App Tester d'Amazon, puis retirez-le.
# AMAZON_SKUS (facultatif) : identifiants de produit acceptes, separes par des virgules.
# AMAZON_GRACE_DAYS (facultatif, 3 par defaut) : jours d'acces conserves apres la
#   fin de periode, comme marge de securite si Amazon est injoignable au moment
#   ou le serveur reverifie l'abonnement (il le fait lui-meme, toutes les 12 h
#   au plus, quand quelqu'un ouvre l'application).
AMAZON_RVS_SECRET=
AMAZON_RVS_MODE=
AMAZON_SKUS=
AMAZON_GRACE_DAYS=

# --- Comptes de test pour les relecteurs d'Amazon ---------------------------
# Mots de passe (8 caracteres minimum) des deux comptes de test
# relecteur-amazon-1@example.com et relecteur-amazon-2@example.com, crees par le
# serveur lui-meme (voir reviewers.js). A RETIRER apres l'approbation d'Amazon :
# les deux comptes sont alors supprimes. Laisser VIDE en temps normal.
REVIEWER_PASSWORD_1=
REVIEWER_PASSWORD_2=

# --- E-mails transactionnels (Resend) ---------------------------------------
# RESEND_FROM doit utiliser un domaine VERIFIE chez Resend. Le domaine de test
# onboarding@resend.dev n'envoie qu'a votre propre adresse : en production, vos
# clients ne recevraient ni code d'invitation ni lien de resiliation.
RESEND_API_KEY=
RESEND_FROM=Spectra <contact@votre-domaine.example>

# Uniquement pour les tests automatises. Ne jamais mettre a 1 en production.
DISABLE_RATE_LIMIT=

# ---------------------------------------------------------------------------
# ENVOI D'E-MAILS SANS ACHETER DE DOMAINE (voie de secours SMTP)
# ---------------------------------------------------------------------------
# Resend refuse d'ecrire a vos clients tant qu'un domaine n'est pas verifie.
# Un compte e-mail gratuit fonctionne en SMTP sans domaine : renseignez ces
# trois variables et laissez RESEND_API_KEY vide.
#
# Gmail : activez la validation en deux etapes, puis creez un "mot de passe
# d'application" sur myaccount.google.com/apppasswords. Le mot de passe normal
# du compte ne fonctionne pas. Environ 500 envois par jour, largement assez.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Spectra <votre.adresse@gmail.com>

# ---------------------------------------------------------------------------
# SAUVEGARDES (indispensable : les bases gratuites Render sont supprimees a 30 jours)
# ---------------------------------------------------------------------------
# ADMIN_TOKEN protege /admin/etat, /admin/backup et /admin/restore.
# Sans lui, ces routes repondent 404 et n'existent tout simplement pas.
ADMIN_TOKEN=

# Phrase secrete de chiffrement des sauvegardes (AES-256). Notez-la ailleurs :
# sans elle, une sauvegarde chiffree est definitivement illisible.
BACKUP_PASSPHRASE=

# Depot de sauvegarde automatique quotidienne. Le depot DOIT etre PRIVE.
# Creez un jeton GitHub a portee "Contents: read and write" sur ce seul depot.
GITHUB_TOKEN=
GITHUB_BACKUP_REPO=kev23-hub/spectra-sauvegardes

# ---------------------------------------------------------------------------
# MAINTIEN EN EVEIL (plan gratuit Render)
# ---------------------------------------------------------------------------
# Le service s'endort apres 15 min et met ~50 s a se reveiller. On le garde
# eveille uniquement aux heures ou vos utilisateurs sont actifs, pour rester
# dans le quota gratuit de 750 h/mois. KEEPALIVE=0 pour desactiver.
# Pendant l'examen de l'application par Amazon : KEEPALIVE_START=0 et
# KEEPALIVE_END=24 (le testeur peut arriver a n'importe quelle heure, et une
# application qui ne demarre pas est refusee). A remettre apres l'approbation.
KEEPALIVE=1
KEEPALIVE_START=7
KEEPALIVE_END=23
TZ=Europe/Paris
