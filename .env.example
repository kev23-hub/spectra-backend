PORT=3000
JWT_SECRET=change-moi-en-une-longue-chaine-aleatoire
DB_PATH=./spectra.db

# Notifications push (Web Push). Generez une paire de cles avec :
#   npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:contact@votre-domaine.example
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Paiements Stripe.
# STRIPE_SECRET_KEY : cle secrete (sk_test_... puis sk_live_...) -- NE JAMAIS
#   la partager, la commiter dans Git, ou la coller dans une conversation.
#   Recuperez-la sur https://dashboard.stripe.com/apikeys (mode Test d'abord).
# STRIPE_DEFAULT_PRICE_ID : l'identifiant du prix/abonnement cree dans
#   Stripe Dashboard > Produits (ex: price_1AbCdEfGhIjKlMnO).
# STRIPE_WEBHOOK_SECRET : signature du webhook, donnee par Stripe quand vous
#   creez le endpoint (voir README.md, section Stripe, pour la marche a suivre).
APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_DEFAULT_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Envoi d'e-mails d'invitation (Resend, https://resend.com).
# RESEND_API_KEY : cle secrete -- meme regle que pour Stripe, jamais partagee.
#   Creez un compte gratuit sur resend.com, verifiez un domaine (ou utilisez
#   leur domaine de test onboarding@resend.dev pour commencer), puis copiez
#   la cle depuis leur tableau de bord.
# RESEND_FROM : l'adresse d'expedition, ex. "Spectra <contact@votre-domaine.example>"
#   (doit correspondre a un domaine verifie dans Resend en production).
RESEND_API_KEY=
RESEND_FROM=
